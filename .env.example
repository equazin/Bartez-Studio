# ============================================================
# Bartez Tecnología — variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# Todas son OPCIONALES: sin ellas, el form igual recibe el lead
# (lo loguea) y cada integración se marca "skipped" sin romper.
# ============================================================

# ---------- Persistencia primaria de leads ----------
# Endpoint HTTPS propio/automatización que acepte el lead como JSON.
# Si monday o Apollo están activos, también cuentan como destinos durables.
LEAD_STORE_URL=
LEAD_STORE_TOKEN=

# ---------- Apollo.io (CRM / prospección) ----------
# REST API key de Apollo (Settings > Integrations > API)
APOLLO_API_KEY=

# ---------- monday.com (pipeline de leads) ----------
# Board "Leads Web Bartez" ya creado. Sólo falta el token:
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=18418630086
MONDAY_GROUP_ID=topics
# IDs de columnas (ya mapeados — board "Leads Web Bartez")
MONDAY_COL_EMPRESA=text_mm4gmwsf
MONDAY_COL_EMAIL=email_mm4gfs0f
MONDAY_COL_TELEFONO=phone_mm4gxh5s
MONDAY_COL_TIPO=color_mm4g97d1
MONDAY_COL_MENSAJE=long_text_mm4gda50
MONDAY_COL_ESTADO=color_mm4gyw76

# ---------- Email transaccional ----------
# provider: "resend" | "brevo"
MAIL_PROVIDER=
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=Bartez Tecnología <ventas@bartez.com.ar>
MAIL_TO=ventas@bartez.com.ar

# ---------- Descargas (Google Drive) ----------
DRIVE_BROCHURE_URL=

# ---------- Agenda (opcional, Cal.com) ----------
CALENDAR_PROVIDER=
NEXT_PUBLIC_CALCOM_BOOKING_URL=

# ---------- Analytics (públicas, sólo cargan tras consentimiento) ----------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Microsoft Clarity (heatmaps + grabaciones de sesión, gratis): clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# ---------- Mapa (opcional, Google Maps) ----------
NEXT_PUBLIC_MAPS_KEY=

# Vercel AI Gateway (OIDC en Vercel; API key opcional fuera de Vercel)
AI_GATEWAY_MODEL=openai/gpt-5.4
AI_GATEWAY_API_KEY=

# ---------- Admin de contenidos (obligatorias para /admin) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Mínimo 32 caracteres aleatorios
ADMIN_JWT_SECRET=

# Base PostgreSQL usada por Prisma
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Vercel Blob para imágenes del admin (obligatoria en producción)
BLOB_READ_WRITE_TOKEN=

# ---------- WhatsApp Cloud API (Bot) ----------
# Obtener desde Meta for Developers > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
# App Secret (Settings > Basic > App Secret) para validar webhooks
WHATSAPP_APP_SECRET=
# Token personalizado para la verificación GET del webhook
WEBHOOK_VERIFY_TOKEN=

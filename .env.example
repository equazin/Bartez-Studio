# ============================================================
# Bartez TecnologÃ­a â€” variables de entorno
# CopiÃ¡ este archivo a .env.local y completÃ¡ los valores.
# Todas son OPCIONALES: sin ellas, el form igual recibe el lead
# (lo loguea) y cada integraciÃ³n se marca "skipped" sin romper.
# ============================================================

# ---------- Persistencia primaria de leads ----------
# Endpoint HTTPS propio/automatizaciÃ³n que acepte el lead como JSON.
# Si monday o Apollo estÃ¡n activos, tambiÃ©n cuentan como destinos durables.
LEAD_STORE_URL=
LEAD_STORE_TOKEN=

# ---------- Apollo.io (CRM / prospecciÃ³n) ----------
# REST API key de Apollo (Settings > Integrations > API)
APOLLO_API_KEY=

# ---------- monday.com (pipeline de leads) ----------
# Board "Leads Web Bartez" ya creado. SÃ³lo falta el token:
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=
MONDAY_GROUP_ID=
# IDs de columnas (mapear segun el board real)
MONDAY_COL_EMPRESA=
MONDAY_COL_EMAIL=
MONDAY_COL_TELEFONO=
MONDAY_COL_TIPO=
MONDAY_COL_MENSAJE=
MONDAY_COL_ESTADO=

# ---------- Email transaccional ----------
# provider: "resend" | "brevo"
MAIL_PROVIDER=
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=Bartez <ventas@example.com>
MAIL_TO=ventas@example.com

# ---------- Descargas (Google Drive) ----------
DRIVE_BROCHURE_URL=

# ---------- Agenda (opcional, Cal.com) ----------
CALENDAR_PROVIDER=
NEXT_PUBLIC_CALCOM_BOOKING_URL=

# ---------- Analytics (pÃºblicas, sÃ³lo cargan tras consentimiento) ----------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Microsoft Clarity (heatmaps + grabaciones de sesiÃ³n, gratis): clarity.microsoft.com
NEXT_PUBLIC_CLARITY_ID=

# ---------- Mapa (opcional, Google Maps) ----------
NEXT_PUBLIC_MAPS_KEY=

# Vercel AI Gateway (OIDC en Vercel; API key opcional fuera de Vercel)
AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5
AI_GATEWAY_API_KEY=

# ---------- Admin de contenidos (obligatorias para /admin) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# MÃ­nimo 32 caracteres aleatorios
ADMIN_JWT_SECRET=

# Base PostgreSQL usada por Prisma
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Vercel Blob para imÃ¡genes del admin (obligatoria en producciÃ³n)
BLOB_READ_WRITE_TOKEN=

# ---------- WhatsApp Cloud API (Bot) ----------
# Obtener desde Meta for Developers > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
# App Secret (Settings > Basic > App Secret) para validar webhooks
WHATSAPP_APP_SECRET=
# Token personalizado para la verificaciÃ³n GET del webhook
WEBHOOK_VERIFY_TOKEN=
# Mantener true en producciÃ³n: pide SI/NO antes de crear lead desde WhatsApp
WHATSAPP_REQUIRE_LEAD_CONFIRMATION=true
# Usar solo en sandbox de Meta si los nÃºmeros permitidos no coinciden con el formato entrante
WHATSAPP_SANDBOX_NUMBER_NORMALIZATION=false
# Habilita descarga de audio + Whisper con OPENAI_API_KEY. Dejar false si no se usa.
WHATSAPP_AUDIO_TRANSCRIPTION_ENABLED=false
OPENAI_API_KEY=

# ---------- Meta App (Facebook + Instagram) para /admin/marketing ----------
# Facebook App (tipo Business) con Facebook Login for Business habilitado.
# Alcances requeridos: pages_show_list, pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish, business_management.
META_APP_ID=
META_APP_SECRET=
# URL absoluta al callback (debe estar autorizada en la config de la app):
# https://<dominio>/api/admin/marketing/oauth/meta/callback
META_APP_REDIRECT_URI=


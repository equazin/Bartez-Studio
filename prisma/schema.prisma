datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────
// Núcleo multi-tenant (Fase 0)
// Toda tabla de negocio se scopea a una Organization. Las columnas
// organizationId en tablas preexistentes son nullable durante la
// transición y se backfillean a la organización semilla "bartez".
// ─────────────────────────────────────────────────────────────

model Organization {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  taxId          String? // CUIT
  enabledModules Json? // feature flags por organización
  branding       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  memberships    Membership[]
  sequences      Sequence[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner | admin | member | viewer
  permissions    Json? // overrides puntuales sobre el rol
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Sequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  docType        String // presupuesto | pedido | factura_a | factura_b | nota_credito | remito ...
  pointOfSale    Int          @default(1)
  nextNumber     Int          @default(1)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, docType, pointOfSale])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  base      String // "USD"
  quote     String // "ARS"
  rate      Decimal  @db.Decimal(18, 6)
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([base, quote, date])
  @@index([date])
}

model DomainEvent {
  id             String    @id @default(cuid())
  organizationId String?
  type           String
  payload        Json
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([type, processedAt])
  @@index([organizationId])
}

model Post {
  id              Int      @id @default(autoincrement())
  organizationId  String?
  slug            String   @unique
  title           String
  excerpt         String
  date            String
  cover           String
  metaDescription String
  readingTime     String
  body            Json
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model ClientLogo {
  id             Int      @id @default(autoincrement())
  organizationId String?
  name           String
  logoUrl        String
  displayOrder   Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model SuccessCase {
  id             Int      @id @default(autoincrement())
  organizationId String?
  title          String
  clientName     String
  logoUrl        String?
  coverImage     String
  description    String
  metrics        Json
  content        String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model WaConversation {
  id             String      @id @default(cuid())
  organizationId String?
  waId           String      @unique
  profileName    String?
  category       String?
  status         String      @default("active")
  leadCreated    Boolean     @default(false)
  messages       WaMessage[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, updatedAt])
  @@index([organizationId])
}

model WaMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   WaConversation  @relation(fields: [conversationId], references: [id])
  waMessageId    String          @unique
  direction      String
  type           String
  body           String?
  category       String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  @@index([conversationId, createdAt])
}

model Lead {
  id             Int      @id @default(autoincrement())
  organizationId String?
  name           String
  company        String?
  email          String?
  phone          String?
  source         String   @default("whatsapp")
  status         String   @default("nuevo")
  value          Float?
  notes          String?
  waId           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId String?
  action         String
  entity         String
  entityId       String
  changes        Json?
  adminUser      String   @default("admin")
  createdAt      DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([organizationId])
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model Post {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
  excerpt         String
  date            String
  cover           String
  metaDescription String
  readingTime     String
  body            Json
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClientLogo {
  id           Int      @id @default(autoincrement())
  name         String
  logoUrl      String
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SuccessCase {
  id          Int      @id @default(autoincrement())
  title       String
  clientName  String
  logoUrl     String?
  coverImage  String
  description String
  metrics     Json
  content     String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WaConversation {
  id          String      @id @default(cuid())
  waId        String      @unique
  profileName String?
  category    String?
  status      String      @default("active")
  leadCreated Boolean     @default(false)
  messages    WaMessage[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, updatedAt])
}

model WaMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   WaConversation  @relation(fields: [conversationId], references: [id])
  waMessageId    String          @unique
  direction      String
  type           String
  body           String?
  category       String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  @@index([conversationId, createdAt])
}

model Lead {
  id          Int      @id @default(autoincrement())
  name        String
  company     String?
  email       String?
  phone       String?
  source      String   @default("whatsapp")
  status      String   @default("nuevo")
  value       Float?
  notes       String?
  waId        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  String
  changes   Json?
  adminUser String   @default("admin")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────
// Núcleo multi-tenant (Fase 0)
// Toda tabla de negocio se scopea a una Organization. Las columnas
// organizationId en tablas preexistentes son nullable durante la
// transición y se backfillean a la organización semilla "bartez".
// ─────────────────────────────────────────────────────────────

model Organization {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  taxId          String? // CUIT
  enabledModules Json? // feature flags por organización
  branding       Json?
  settings       Json? // configuración operativa (umbral de aprobación, límites…)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  memberships    Membership[]
  sequences      Sequence[]
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  passwordHash    String
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  memberships     Membership[]
  assignedLeads   Lead[]        @relation("LeadAssignee")
  ownedAccounts   Account[]     @relation("AccountOwner")
  ownedOpps       Opportunity[] @relation("OpportunityOwner")
  assignedActs    Activity[]    @relation("ActivityAssignee")
  ownedQuotes     Quote[]       @relation("QuoteOwner")
  ownedOrders     SalesOrder[]  @relation("OrderOwner")
  assignedTickets Ticket[]      @relation("TicketAssignee")
  authoredArticles KnowledgeArticle[] @relation("ArticleAuthor")
  assignedWorkOrders WorkOrder[] @relation("WorkOrderAssignee")
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner | admin | member | viewer
  permissions    Json? // overrides puntuales sobre el rol
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Sequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  docType        String // presupuesto | pedido | factura_a | factura_b | nota_credito | remito ...
  pointOfSale    Int          @default(1)
  nextNumber     Int          @default(1)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, docType, pointOfSale])
}

// ─────────────────────────────────────────────────────────────
// Credenciales de integraciones cifradas por organización.
// Cada fila guarda UN valor sensible (token/api-key/cert) cifrado
// con AES-256-GCM usando CREDENTIAL_ENCRYPTION_KEY (env var maestra).
// El código consulta primero acá y cae a env var si no existe.
// ─────────────────────────────────────────────────────────────
model OrgCredential {
  id              String   @id @default(cuid())
  organizationId  String
  provider        String // "mercadopago" | "afip" | "openai" | "whatsapp" | "resend" | ...
  key             String // "access_token" | "api_key" | "cert" | "phone_number_id" | ...
  valueCiphertext String // hex
  iv              String // hex (12 bytes)
  authTag         String // hex (16 bytes)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([organizationId, provider, key])
  @@index([organizationId, provider])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  base      String // "USD"
  quote     String // "ARS"
  rate      Decimal  @db.Decimal(18, 6)
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([base, quote, date])
  @@index([date])
}

model DomainEvent {
  id             String    @id @default(cuid())
  organizationId String?
  type           String
  payload        Json
  status         String    @default("processed")
  attemptCount   Int       @default(0)
  lastAttemptAt  DateTime?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([type, processedAt])
  @@index([organizationId])
  @@index([type, status])
}

model AdCampaign {
  id                 String          @id @default(cuid())
  organizationId     String
  platform           String // google_ads | meta_ads
  externalCampaignId String
  name               String
  status             String          @default("unknown")
  dailyBudget        Decimal?        @db.Decimal(14, 2)
  lastSyncedAt       DateTime?
  metrics            AdMetricDaily[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([organizationId, platform, externalCampaignId])
  @@index([organizationId, platform])
  @@index([status])
}

model AdMetricDaily {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date        DateTime
  spend       Decimal    @default(0) @db.Decimal(14, 2)
  impressions Int        @default(0)
  clicks      Int        @default(0)
  leads       Int        @default(0)
  conversions Int        @default(0)
  revenue     Decimal    @default(0) @db.Decimal(14, 2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([campaignId, date])
  @@index([date])
}

model Post {
  id              Int      @id @default(autoincrement())
  organizationId  String?
  slug            String   @unique
  title           String
  excerpt         String
  date            String
  cover           String
  metaDescription String
  readingTime     String
  body            Json
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model ClientLogo {
  id             Int      @id @default(autoincrement())
  organizationId String?
  name           String
  logoUrl        String
  displayOrder   Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model SuccessCase {
  id             Int      @id @default(autoincrement())
  organizationId String?
  title          String
  clientName     String
  logoUrl        String?
  coverImage     String
  description    String
  metrics        Json
  content        String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model WaConversation {
  id             String      @id @default(cuid())
  organizationId String?
  waId           String      @unique
  profileName    String?
  category       String?
  status         String      @default("active")
  leadCreated    Boolean     @default(false)
  messages       WaMessage[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, updatedAt])
  @@index([organizationId])
}

model WaMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   WaConversation  @relation(fields: [conversationId], references: [id])
  waMessageId    String          @unique
  direction      String
  type           String
  body           String?
  category       String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  @@index([conversationId, createdAt])
}

model Lead {
  id             Int      @id @default(autoincrement())
  organizationId String?
  accountId      String?
  account        Account? @relation(fields: [accountId], references: [id])
  assignedToId   String?
  assignedTo     User?    @relation("LeadAssignee", fields: [assignedToId], references: [id])
  name           String
  company        String?
  email          String?
  phone          String?
  source         String   @default("whatsapp")
  status         String   @default("nuevo")
  value          Float?
  notes          String?
  waId           String?
  // --- Atribución publicitaria (Google/Meta Ads) ---
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  gclid          String?  // Google Click ID
  fbclid         String?  // Meta (Facebook) Click ID
  landingUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
  @@index([accountId])
  @@index([assignedToId])
  @@index([utmCampaign])
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId String?
  action         String
  entity         String
  entityId       String
  changes        Json?
  adminUser      String   @default("admin")
  createdAt      DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────
// Comercial / CRM (Fase 1)
// Account = empresa cliente. Contact = persona vinculada a una Account.
// Activity = llamada/email/reunión/tarea con due date. Opportunity = deal
// con valor, etapa, probabilidad y cierre estimado.
// ─────────────────────────────────────────────────────────────

model Account {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  taxId          String?
  industry       String?
  website        String?
  phone          String?
  email          String?
  address        String?
  city           String?
  country        String?
  notes          String?
  ownerId        String?
  owner          User?         @relation("AccountOwner", fields: [ownerId], references: [id])
  contacts       Contact[]
  leads          Lead[]
  opportunities  Opportunity[]
  activities     Activity[]
  quotes         Quote[]
  orders         SalesOrder[]
  deliveryNotes  DeliveryNote[]
  invoices       Invoice[]
  receipts       Receipt[]
  accountEntries CustomerAccountEntry[]
  tickets        Ticket[]
  workOrders     WorkOrder[]
  serialNumbers  SerialNumber[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([ownerId])
  @@index([name])
}

model Contact {
  id             String     @id @default(cuid())
  organizationId String
  accountId      String?
  account        Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  jobTitle       String?
  notes          String?
  activities     Activity[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([accountId])
  @@index([email])
}

model Opportunity {
  id             String     @id @default(cuid())
  organizationId String
  accountId      String?
  account        Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?      @relation("OpportunityOwner", fields: [ownerId], references: [id])
  title          String
  stage          String     @default("qualification") // qualification | proposal | negotiation | won | lost
  amount         Decimal?   @db.Decimal(14, 2)
  currency       String     @default("USD")
  probability    Int        @default(20) // 0..100
  expectedClose  DateTime?
  closedAt       DateTime?
  lostReason     String?
  notes          String?
  activities     Activity[]
  quotes         Quote[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  @@index([organizationId, stage])
  @@index([accountId])
  @@index([ownerId])
  @@index([expectedClose])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  type           String // call | email | meeting | task | note
  subject        String
  body           String?
  status         String       @default("pending") // pending | done | cancelled
  dueAt          DateTime?
  completedAt    DateTime?
  assignedToId   String?
  assignedTo     User?        @relation("ActivityAssignee", fields: [assignedToId], references: [id])
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, dueAt])
  @@index([assignedToId, status])
  @@index([accountId])
  @@index([opportunityId])
}

// ─────────────────────────────────────────────────────────────
// Catálogo + Ventas (Fase 2)
// Product: bienes y servicios. PriceList: lista de precios (multi-moneda).
// PriceListItem: precio de un producto en una lista. Quote: cotización
// con QuoteLine[]. Los totales se persisten denormalizados para reportes
// pero también se recalculan desde las líneas en el servicio.
// ─────────────────────────────────────────────────────────────

model Product {
  id             String           @id @default(cuid())
  organizationId String
  sku            String?
  name           String
  description    String?
  type           String           @default("good") // good | service
  unit           String           @default("unit") // unit | hour | month
  brand          String?
  supplier       String?
  stockTracked   Boolean          @default(false) // true: gestión de stock; false: bajo pedido
  active         Boolean          @default(true)
  taxRate        Decimal          @default(21) @db.Decimal(5, 2) // IVA por defecto (%)
  prices         PriceListItem[]
  quoteLines     QuoteLine[]
  orderLines     SalesOrderLine[]
  deliveryLines  DeliveryNoteLine[]
  purchaseLines  PurchaseOrderLine[]
  goodsReceiptLines GoodsReceiptLine[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  serialNumbers  SerialNumber[]
  workOrderItems WorkOrderItem[]
  warrantyTerms  WarrantyTerm[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, sku])
  @@index([organizationId, active])
  @@index([name])
}

model PriceList {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  currency       String          @default("USD") // USD | ARS | EUR
  isDefault      Boolean         @default(false)
  active         Boolean         @default(true)
  items          PriceListItem[]
  quotes         Quote[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isDefault])
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice   Decimal   @db.Decimal(14, 4)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([priceListId, productId])
  @@index([productId])
}

model Quote {
  id              String       @id @default(cuid())
  organizationId  String
  number          String // Folio asignado (ej. "COT-2026-0001")
  accountId       String?
  account         Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  ownerId         String?
  owner           User?        @relation("QuoteOwner", fields: [ownerId], references: [id])
  priceListId     String?
  priceList       PriceList?   @relation(fields: [priceListId], references: [id])
  status          String       @default("draft") // draft | sent | accepted | rejected | expired
  currency        String       @default("USD")
  issueDate       DateTime     @default(now())
  validUntil      DateTime?
  notes           String?
  terms           String?
  // Totales persistidos (calculados desde QuoteLine[])
  subtotal        Decimal      @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal      @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal      @default(0) @db.Decimal(14, 2)
  total           Decimal      @default(0) @db.Decimal(14, 2)
  sentAt          DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  lines           QuoteLine[]
  orders          SalesOrder[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([accountId])
  @@index([opportunityId])
}

model QuoteLine {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  position    Int      @default(0)
  description String // snapshot del nombre/descripción en momento de la cotización
  quantity    Decimal  @default(1) @db.Decimal(14, 4)
  unitPrice   Decimal  @db.Decimal(14, 4)
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  taxRate     Decimal  @default(21) @db.Decimal(5, 2)
  // Totales persistidos para reportes; se recalculan en el service
  lineSubtotal Decimal @default(0) @db.Decimal(14, 2)
  lineTax      Decimal @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal @default(0) @db.Decimal(14, 2)

  @@index([quoteId, position])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// Inventario + Pedidos de venta (Fase 3)
// Modelo mixto: productos en stock (stockTracked=true) viven en
// StockItem por depósito; productos bajo pedido se cubren con OC.
// Reserva = StockMovement type=reserve; al entregar se descuenta.
// ─────────────────────────────────────────────────────────────

model Warehouse {
  id             String          @id @default(cuid())
  organizationId String
  code           String // identificador corto (DEP01)
  name           String
  address        String?
  isDefault      Boolean         @default(false)
  active         Boolean         @default(true)
  stockItems     StockItem[]
  goodsReceipts  GoodsReceipt[]
  movements      StockMovement[] @relation("WarehouseMovements")
  movementsFrom  StockMovement[] @relation("WarehouseFromMovements")
  movementsTo    StockMovement[] @relation("WarehouseToMovements")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model StockItem {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Decimal   @default(0) @db.Decimal(14, 4) // stock disponible (no reservado)
  reserved    Decimal   @default(0) @db.Decimal(14, 4) // unidades reservadas por pedidos confirmados
  reorderPoint Decimal? @db.Decimal(14, 4) // alerta de stock bajo
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
}

model StockMovement {
  id              String     @id @default(cuid())
  organizationId  String
  type            String // in | out | transfer | adjust | reserve | release
  productId       String
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId     String? // depósito principal del movimiento (in/out/adjust/reserve/release)
  warehouse       Warehouse? @relation("WarehouseMovements", fields: [warehouseId], references: [id])
  fromWarehouseId String? // transfer
  fromWarehouse   Warehouse? @relation("WarehouseFromMovements", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String? // transfer
  toWarehouse     Warehouse? @relation("WarehouseToMovements", fields: [toWarehouseId], references: [id])
  quantity        Decimal    @db.Decimal(14, 4) // siempre positivo; el type define el signo
  reason          String? // motivo (entrega de SO, recepción de OC, ajuste físico, etc.)
  referenceType  String? // sales_order | purchase_order | manual
  referenceId    String?
  createdAt       DateTime   @default(now())

  @@index([organizationId, createdAt])
  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}

model SalesOrder {
  id              String           @id @default(cuid())
  organizationId  String
  number          String // PED-0001-00000001
  accountId       String?
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  quoteId         String?
  quote           Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  ownerId         String?
  owner           User?            @relation("OrderOwner", fields: [ownerId], references: [id])
  warehouseId     String? // depósito de salida; opcional para bajo pedido puro
  status          String           @default("draft") // draft | confirmed | in_preparation | delivered | cancelled
  currency        String           @default("USD")
  orderDate       DateTime         @default(now())
  expectedDate    DateTime?
  notes           String?
  subtotal        Decimal          @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal          @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal          @default(0) @db.Decimal(14, 2)
  total           Decimal          @default(0) @db.Decimal(14, 2)
  confirmedAt     DateTime?
  preparedAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  lines           SalesOrderLine[]
  deliveryNotes   DeliveryNote[]
  invoices        Invoice[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([accountId])
  @@index([quoteId])
}

model SalesOrderLine {
  id           String    @id @default(cuid())
  orderId      String
  order        SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  position     Int       @default(0)
  description  String
  quantity     Decimal   @default(1) @db.Decimal(14, 4)
  unitPrice    Decimal   @db.Decimal(14, 4)
  discountPct  Decimal   @default(0) @db.Decimal(5, 2)
  taxRate      Decimal   @default(21) @db.Decimal(5, 2)
  lineSubtotal Decimal   @default(0) @db.Decimal(14, 2)
  lineTax      Decimal   @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal   @default(0) @db.Decimal(14, 2)
  // Fulfillment: cuántas unidades quedaron pendientes vs entregadas
  delivered    Decimal   @default(0) @db.Decimal(14, 4)
  backorder    Boolean   @default(false) // marcada para producto bajo pedido

  @@index([orderId, position])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// Facturación AFIP + Cobranzas (Fase 4)
// Invoice = comprobante electrónico (A/B/C, NC/ND). El CAE se solicita
// a AFIP vía WSFE; mientras tanto status="draft"; al obtener CAE pasa
// a "issued". Receipt = cobranza con allocations a una o más Invoices.
// CustomerAccountEntry es el libro mayor por cuenta (factura, recibo,
// NC) que permite calcular saldo simple.
// ─────────────────────────────────────────────────────────────

model DeliveryNote {
  id              String             @id @default(cuid())
  organizationId  String
  number          String // REM-0001-00000001
  pointOfSale     Int                @default(1)
  accountId       String?
  account         Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  orderId         String?
  order           SalesOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receiverName    String
  receiverTaxId   String?
  receiverAddress String?
  issueDate       DateTime           @default(now())
  status          String             @default("issued") // draft | issued | cancelled
  notes           String?
  lines           DeliveryNoteLine[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([accountId])
  @@index([orderId])
}

model DeliveryNoteLine {
  id             String       @id @default(cuid())
  deliveryNoteId String
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  position       Int          @default(0)
  description    String
  quantity       Decimal      @default(1) @db.Decimal(14, 4)

  @@index([deliveryNoteId, position])
  @@index([productId])
}

model Invoice {
  id              String                  @id @default(cuid())
  organizationId  String
  number          String // FCA-0001-00000001 (interno hasta tener CAE)
  // Datos AFIP
  docTypeCode     Int // 1 = Factura A, 6 = Factura B, 11 = Factura C, 3 = NC A, 8 = NC B, 13 = NC C, etc.
  pointOfSale     Int // PtoVta
  afipNumber      Int? // CbteDesde/Hasta otorgado en la respuesta
  cae             String? // CAE devuelto por AFIP
  caeExpiresAt    DateTime? // FchVtoCAE
  afipStatus      String                  @default("pending") // pending | issued | rejected
  afipObservations Json?                  // detalle del rechazo o avisos
  // Comprobante asociado en NC/ND
  relatedInvoiceId String?
  relatedInvoice   Invoice?                @relation("InvoiceRelated", fields: [relatedInvoiceId], references: [id])
  reversals       Invoice[]                @relation("InvoiceRelated")
  // Vínculos comerciales
  accountId       String?
  account         Account?                @relation(fields: [accountId], references: [id], onDelete: SetNull)
  orderId         String?
  order           SalesOrder?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Datos del receptor (snapshot)
  receiverName     String
  receiverTaxId    String?
  receiverDocType  Int? // 80=CUIT, 86=CUIL, 96=DNI, 99=Consumidor Final
  receiverAddress  String?
  // Datos del comprobante
  currency        String                  @default("ARS") // PES, USD, EUR — internamente guardamos código corto
  exchangeRate    Decimal                 @default(1) @db.Decimal(18, 6)
  issueDate       DateTime                @default(now())
  serviceFrom     DateTime?
  serviceTo       DateTime?
  paymentDueDate  DateTime?
  // Totales
  subtotal        Decimal                 @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal                 @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal                 @default(0) @db.Decimal(14, 2)
  total           Decimal                 @default(0) @db.Decimal(14, 2)
  notes           String?
  status          String                  @default("draft") // draft | issued | cancelled
  issuedAt        DateTime?
  cancelledAt     DateTime?
  lines           InvoiceLine[]
  allocations     ReceiptAllocation[]
  paymentLinks    PaymentLink[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?

  @@unique([organizationId, pointOfSale, docTypeCode, afipNumber])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([accountId])
  @@index([orderId])
  @@index([cae])
}

model InvoiceLine {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String?
  position     Int      @default(0)
  description  String
  quantity     Decimal  @default(1) @db.Decimal(14, 4)
  unitPrice    Decimal  @db.Decimal(14, 4)
  discountPct  Decimal  @default(0) @db.Decimal(5, 2)
  taxRate      Decimal  @default(21) @db.Decimal(5, 2)
  lineSubtotal Decimal  @default(0) @db.Decimal(14, 2)
  lineTax      Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal  @default(0) @db.Decimal(14, 2)

  @@index([invoiceId, position])
}

model Receipt {
  id             String              @id @default(cuid())
  organizationId String
  number         String // REC-0001-00000001
  accountId      String
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  receivedAt     DateTime            @default(now())
  method         String // cash | transfer | card | mercadopago | other
  reference      String? // n° de transferencia, etc.
  amount         Decimal             @db.Decimal(14, 2)
  currency       String              @default("ARS")
  notes          String?
  allocations    ReceiptAllocation[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, number])
  @@index([organizationId, accountId])
  @@index([receivedAt])
}

model ReceiptAllocation {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal @db.Decimal(14, 2)

  @@unique([receiptId, invoiceId])
  @@index([invoiceId])
}

model CustomerAccountEntry {
  id             String   @id @default(cuid())
  organizationId String
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date           DateTime @default(now())
  type           String // invoice | receipt | credit_note | adjust
  referenceType  String? // invoice | receipt
  referenceId    String?
  description    String
  // Positivo = aumenta saldo deudor (cliente debe). Negativo = lo reduce.
  debit          Decimal  @default(0) @db.Decimal(14, 2)
  credit         Decimal  @default(0) @db.Decimal(14, 2)
  currency       String   @default("ARS")
  createdAt      DateTime @default(now())

  @@index([organizationId, accountId, date])
  @@index([referenceType, referenceId])
}

model PaymentLink {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  provider       String   @default("mercadopago") // mercadopago | manual
  externalId     String? // preference_id en MP
  url            String?
  amount         Decimal  @db.Decimal(14, 2)
  currency       String   @default("ARS")
  status         String   @default("pending") // pending | paid | expired | cancelled
  expiresAt      DateTime?
  paidAt         DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
  @@index([externalId])
}

model AfipTaCache {
  id             String   @id @default(cuid())
  organizationId String
  cuit           String
  service        String // wsfe | wsfev1
  mode           String // homo | prod
  token          String
  sign           String
  generationTime DateTime
  expirationTime DateTime
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, cuit, service, mode])
  @@index([expirationTime])
}

// Phase 5: Purchases + Treasury

model Supplier {
  id             String                 @id @default(cuid())
  organizationId String
  name           String
  taxId          String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  paymentTerms   String?
  notes          String?
  active         Boolean                @default(true)
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  payments       SupplierPayment[]
  accountEntries SupplierAccountEntry[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?

  @@index([organizationId, active])
  @@index([organizationId, name])
  @@index([taxId])
}

model PurchaseOrder {
  id             String                 @id @default(cuid())
  organizationId String
  number         String
  supplierId     String
  supplier       Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status         String                 @default("issued") // draft | issued | partially_received | received | cancelled
  approvalStatus String                 @default("not_required") // not_required | pending | approved | rejected
  approvedById   String?
  approvedAt     DateTime?
  approvalNote   String?
  currency       String                 @default("ARS")
  issueDate      DateTime               @default(now())
  expectedDate   DateTime?
  notes          String?
  subtotal       Decimal                @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal                @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal                @default(0) @db.Decimal(14, 2)
  total          Decimal                @default(0) @db.Decimal(14, 2)
  issuedAt       DateTime?
  receivedAt     DateTime?
  cancelledAt    DateTime?
  lines          PurchaseOrderLine[]
  receipts       GoodsReceipt[]
  allocations    SupplierPaymentAllocation[]
  accountEntries SupplierAccountEntry[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([supplierId])
  @@index([issueDate])
}

model PurchaseOrderLine {
  id              String             @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  position        Int                @default(0)
  description     String
  quantity        Decimal            @default(1) @db.Decimal(14, 4)
  unitPrice       Decimal            @db.Decimal(14, 4)
  discountPct     Decimal            @default(0) @db.Decimal(5, 2)
  taxRate         Decimal            @default(21) @db.Decimal(5, 2)
  lineSubtotal    Decimal            @default(0) @db.Decimal(14, 2)
  lineTax         Decimal            @default(0) @db.Decimal(14, 2)
  lineTotal       Decimal            @default(0) @db.Decimal(14, 2)
  received        Decimal            @default(0) @db.Decimal(14, 4)
  receiptLines    GoodsReceiptLine[]

  @@index([purchaseOrderId, position])
  @@index([productId])
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  organizationId  String
  number          String
  supplierId      String?
  supplier        Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  warehouseId     String
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedAt      DateTime           @default(now())
  status          String             @default("received") // received | cancelled
  notes           String?
  lines           GoodsReceiptLine[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  @@unique([organizationId, number])
  @@index([organizationId, receivedAt])
  @@index([purchaseOrderId])
  @@index([warehouseId])
}

model GoodsReceiptLine {
  id                  String             @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  productId           String?
  product             Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  position            Int                @default(0)
  description         String
  quantity            Decimal            @default(1) @db.Decimal(14, 4)
  unitCost            Decimal            @default(0) @db.Decimal(14, 4)

  @@index([goodsReceiptId, position])
  @@index([purchaseOrderLineId])
  @@index([productId])
}

model SupplierPayment {
  id             String                       @id @default(cuid())
  organizationId String
  number         String
  supplierId     String
  supplier       Supplier                     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  cashAccountId  String?
  cashAccount    CashAccount?                 @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  paidAt         DateTime                     @default(now())
  method         String                       @default("transfer") // cash | transfer | card | mercadopago | other
  reference      String?
  amount         Decimal                      @db.Decimal(14, 2)
  currency       String                       @default("ARS")
  exchangeRate   Decimal                      @default(1) @db.Decimal(14, 6)
  notes          String?
  allocations    SupplierPaymentAllocation[]
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, number])
  @@index([organizationId, supplierId])
  @@index([paidAt])
}

model SupplierPaymentAllocation {
  id              String          @id @default(cuid())
  paymentId       String
  payment         SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  amount          Decimal         @db.Decimal(14, 2)

  @@unique([paymentId, purchaseOrderId])
  @@index([purchaseOrderId])
}

model SupplierAccountEntry {
  id              String         @id @default(cuid())
  organizationId  String
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  date            DateTime       @default(now())
  type            String // purchase_order | payment | adjust
  referenceType   String?
  referenceId     String?
  description     String
  debit           Decimal        @default(0) @db.Decimal(14, 2) // reduces payable
  credit          Decimal        @default(0) @db.Decimal(14, 2) // increases payable
  currency        String         @default("ARS")
  createdAt       DateTime       @default(now())

  @@index([organizationId, supplierId, date])
  @@index([purchaseOrderId])
  @@index([referenceType, referenceId])
}

model CashAccount {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  type           String            @default("bank") // cash | bank
  currency       String            @default("ARS")
  balance        Decimal           @default(0) @db.Decimal(14, 2)
  active         Boolean           @default(true)
  details        Json?
  movements      CashMovement[]
  supplierPayments SupplierPayment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model CashMovement {
  id             String      @id @default(cuid())
  organizationId String
  cashAccountId  String
  cashAccount    CashAccount @relation(fields: [cashAccountId], references: [id], onDelete: Cascade)
  type           String // income | expense | adjust
  date           DateTime    @default(now())
  description    String
  amount         Decimal     @db.Decimal(14, 2)
  currency       String      @default("ARS")
  referenceType  String?
  referenceId    String?
  voidedAt       DateTime?
  createdAt      DateTime    @default(now())

  @@index([organizationId, date])
  @@index([cashAccountId, date])
  @@index([referenceType, referenceId])
}

// ─────────────────────────────────────────────────────────────
// Contabilidad de partida doble (Fase 3).
// LedgerAccount: plan de cuentas jerárquico (activo/pasivo/PN/
// ingresos/egresos). JournalEntry + JournalLine: asientos con
// validación debe = haber. Reportes: Libro Diario, Libro Mayor,
// Balance de Sumas y Saldos.
// ─────────────────────────────────────────────────────────────

model LedgerAccount {
  id             String          @id @default(cuid())
  organizationId String
  code           String // "1.1.01" jerárquico
  name           String
  type           String // asset | liability | equity | income | expense
  parentId       String?
  parent         LedgerAccount?  @relation("LedgerTree", fields: [parentId], references: [id])
  children       LedgerAccount[] @relation("LedgerTree")
  active         Boolean         @default(true)
  lines          JournalLine[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, type])
}

model JournalEntry {
  id             String        @id @default(cuid())
  organizationId String
  number         String // folio interno (AS-0001-00000001)
  date           DateTime
  description    String
  referenceType  String? // invoice | supplier_payment | receipt | cash_movement | manual
  referenceId    String?
  source         String        @default("manual") // manual | auto
  lines          JournalLine[]
  createdAt      DateTime      @default(now())
  voidedAt       DateTime?

  @@unique([organizationId, number])
  @@index([organizationId, date])
  @@index([referenceType, referenceId])
}

model JournalLine {
  id          String        @id @default(cuid())
  entryId     String
  entry       JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit       Decimal       @default(0) @db.Decimal(14, 2)
  credit      Decimal       @default(0) @db.Decimal(14, 2)
  description String?

  @@index([entryId])
  @@index([accountId])
}

// ─────────────────────────────────────────────────────────────
// Postventa, Garantías y Servicios (Fase 6)
// Ticket: solicitud de soporte / RMA. SerialNumber: tracking
// individual de unidades vendidas. WarrantyTerm: política de
// garantía por producto. WorkOrder: orden de trabajo técnica.
// KnowledgeArticle: base de conocimiento reutilizable por el bot.
// ─────────────────────────────────────────────────────────────

model Ticket {
  id              String          @id @default(cuid())
  organizationId  String
  number          String // TCK-0001-00000001
  type            String          @default("support") // support | rma | incident | question
  priority        String          @default("normal") // low | normal | high | urgent
  status          String          @default("new") // new | open | pending | solved | closed
  subject         String
  description     String?
  channel         String          @default("manual") // manual | whatsapp | email | web
  accountId       String?
  account         Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  serialNumberId  String?
  serialNumber    SerialNumber?   @relation(fields: [serialNumberId], references: [id], onDelete: SetNull)
  assignedToId    String?
  assignedTo      User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  workOrders      WorkOrder[]
  messages        TicketMessage[]
  resolutionNotes String?
  firstResponseAt DateTime?
  solvedAt        DateTime?
  closedAt        DateTime?
  dueAt           DateTime? // SLA
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([accountId])
  @@index([assignedToId, status])
  @@index([dueAt])
}

model TicketMessage {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType   String // user | customer | system
  authorName   String?
  body         String
  internal     Boolean  @default(false) // nota interna no visible al cliente
  attachments  Json?
  createdAt    DateTime @default(now())

  @@index([ticketId, createdAt])
}

model WarrantyTerm {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Días de garantía contados desde la fecha de entrega.
  durationDays   Int      @default(365)
  coverage       String? // qué cubre (texto libre, mostrable al cliente)
  exclusions     String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, productId])
}

model SerialNumber {
  id             String        @id @default(cuid())
  organizationId String
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  serial         String
  accountId      String?
  account        Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  orderLineId    String? // origen de la asignación (cuando se entrega un pedido)
  invoiceId      String?
  deliveredAt    DateTime?
  warrantyUntil  DateTime?
  status         String        @default("in_stock") // in_stock | delivered | returned | scrapped
  notes          String?
  tickets        Ticket[]
  workOrders     WorkOrder[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, serial])
  @@index([productId])
  @@index([accountId])
  @@index([warrantyUntil])
  @@index([status])
}

model KnowledgeArticle {
  id             String   @id @default(cuid())
  organizationId String
  slug           String
  title          String
  body           String // markdown
  excerpt        String?
  tags           Json? // array de strings
  category       String?
  authorId       String?
  author         User?    @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  published      Boolean  @default(true)
  views          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, slug])
  @@index([organizationId, published])
  @@index([category])
}

model WorkOrder {
  id              String          @id @default(cuid())
  organizationId  String
  number          String // OT-0001-00000001
  type            String          @default("repair") // install | repair | maintenance | training
  status          String          @default("scheduled") // scheduled | in_progress | completed | cancelled
  priority        String          @default("normal")
  title           String
  description     String?
  accountId       String?
  account         Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  ticketId        String?
  ticket          Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  serialNumberId  String?
  serialNumber    SerialNumber?   @relation(fields: [serialNumberId], references: [id], onDelete: SetNull)
  assignedToId    String?
  assignedTo      User?           @relation("WorkOrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  durationMinutes Int? // tiempo real registrado al cerrar
  items           WorkOrderItem[]
  resolutionNotes String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([assignedToId, status])
  @@index([scheduledFor])
  @@index([accountId])
}

model WorkOrderItem {
  id           String     @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  kind         String     @default("part") // part | labor
  description  String
  quantity     Decimal    @default(1) @db.Decimal(14, 4)
  unitPrice    Decimal    @default(0) @db.Decimal(14, 4)
  billable     Boolean    @default(true)
  notes        String?
  createdAt    DateTime   @default(now())

  @@index([workOrderId])
}
